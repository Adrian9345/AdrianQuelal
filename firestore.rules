rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'adriannoguera93@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.email is string && data.email.size() <= 128
        && (!('name' in data) || (data.name is string && data.name.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string || data.photoURL == null))
        && (!('description' in data) || (data.description is string || data.description == null))
        && (!('isCreator' in data) || (data.isCreator is bool));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if isSignedIn() 
        && (request.auth.uid == userId || isAdmin())
        && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'description', 'isCreator'])
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    function isValidPublication(data) {
      return data.keys().hasAll(['title', 'corregimiento', 'creatorId', 'createdAt'])
        && data.title is string && data.title.size() > 0
        && data.corregimiento is string
        && (data.creatorId == 'static-seed' || (request.auth != null && data.creatorId == request.auth.uid) || isAdmin());
    }

    match /publications/{pubId} {
      allow read: if true;
      allow create: if (isSignedIn() || incoming().creatorId == 'static-seed') && isValidPublication(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin()) && isValidPublication(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && (existing().creatorId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCreator == true || isAdmin()); // Creators or Admins can delete
    }
  }
}
